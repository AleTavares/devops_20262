# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout


# Kiro/Claude config
.claude/

# Notas de avaliação (arquivo local, não versionar)
provas/notas.md
provas/prova-segundo-bimestre.md
.agents/
.kiro
provas/gabarito-segundo-bimestre-teorica.md

provas/prova-segundo-bimestre-teorica.md
provas/prova-segundo-bimestre-pratica.md

# Provas substitutivas do primeiro bimestre
provas/prova-substitutiva-p1-modelo-a.md
provas/prova-substitutiva-p1-modelo-b.md
provas/prova-substitutiva-p1-modelo-c.md
provas/gabarito-substitutiva-p1-modelo-a.md
provas/gabarito-substitutiva-p1-modelo-b.md
provas/gabarito-substitutiva-p1-modelo-c.md
provas/gabarito-substitutiva-p1.md

# Provas de exame
provas/prova-exame-modelo-a.md
provas/prova-exame-modelo-b.md
provas/prova-exame-modelo-c.md
provas/gabarito-exame.md

# Provas substitutivas de exame
provas/prova-substitutiva-exame-modelo-a.md
provas/prova-substitutiva-exame-modelo-b.md
provas/prova-substitutiva-exame-modelo-c.md
provas/gabarito-substitutiva-exame.md

# Proteção genérica: qualquer prova ou gabarito futuro
provas/prova-*.md
provas/gabarito-*.md
provas/*.csv

# Exceção: prova prática do segundo bimestre é pública (enunciado para os alunos)
!provas/prova-segundo-bimestre-pratica.md

